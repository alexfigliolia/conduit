{
  "name": "@figliolia/conduit-react",
  "version": "0.0.1",
  "description": "React bindings for conduit",
  "keywords": [
    "conduit",
    "react",
    "state"
  ],
  "homepage": "https://github.com/alexfigliolia/conduit/blob/main/packages/conduit-react/README.md",
  "license": "MIT",
  "author": "Alex Figliolia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexfigliolia/conduit.git"
  },
  "files": [
    "dist",
    "src/*"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
