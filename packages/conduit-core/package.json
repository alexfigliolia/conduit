{
  "name": "@figliolia/conduit",
  "version": "1.0.0",
  "description": "A framework agnostic state composition library based on Galena",
  "keywords": [
    "conduit",
    "state"
  ],
  "homepage": "https://github.com/alexfigliolia/conduit#readme",
  "license": "MIT",
  "author": "Alex Figliolia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexfigliolia/conduit.git"
  },
  "files": [
    "dist",
    "src/*"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@figliolia/event-emitter": "^2.0.0",
    "@figliolia/galena": "^4.1.0",
    "chalk": "^4.1.2",
    "mitata": "^1.0.34"
  },
  "peerDependencies": {
    "@figliolia/event-emitter": ">=2.0.0",
    "@figliolia/galena": ">=4.1.0"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
