{
  "name": "@figliolia/conduit",
  "version": "1.0.0",
  "description": "A framework agnostic state composition library based on Galena",
  "keywords": [
    "conduit",
    "state"
  ],
  "homepage": "https://github.com/alexfigliolia/conduit#readme",
  "license": "MIT",
  "author": "Alex Figliolia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexfigliolia/conduit.git"
  },
  "files": [
    "dist",
    "src/*"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@figliolia/event-emitter": "^2.0.0",
    "@figliolia/galena": "^4.1.0",
    "chalk": "^4.1.2",
    "mitata": "^1.0.34"
  },
  "peerDependencies": {
    "@figliolia/event-emitter": ">=2.0.0",
    "@figliolia/galena": ">=4.1.0"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
