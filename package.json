{
  "name": "conduit",
  "version": "0.0.1",
  "private": true,
  "description": "A framework agnostic state composition library for server-derived data",
  "keywords": [],
  "homepage": "https://github.com/alexfigliolia/conduit#readme",
  "license": "MIT",
  "author": "Alex Figliolia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexfigliolia/conduit.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "install:repokit": "cargo install repokit",
    "install:rust": "command -v rustc >/dev/null 2>&1 || { curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y; source \"$HOME/.cargo/env\"; }",
    "lint": "pnpm oxlint --type-aware --report-unused-disable-directives --fix && pnpm oxfmt",
    "setup:repo": "pnpm i && pnpm install:rust && pnpm install:repokit",
    "test": "vitest"
  },
  "devDependencies": {
    "@conduit/repokit-templates": "link:./packages/repokit-templates",
    "@repokit/core": "^5.3.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "5.0.0",
    "dpdm": "^4.3.0",
    "madge": "^8.0.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^0.25.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
