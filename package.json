{
  "name": "@figliolia/conduit",
  "version": "1.0.0",
  "description": "A framework agnostic state composition library based on Galena",
  "keywords": [],
  "homepage": "https://github.com/alexfigliolia/conduit#readme",
  "license": "MIT",
  "author": "Alex Figliolia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexfigliolia/conduit.git"
  },
  "files": [
    "dist",
    "src/*"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench": "npx tsx src/__benchmarks__/storage.ts",
    "build": "tsdown",
    "lint": "pnpm oxlint --type-aware --report-unused-disable-directives --fix && pnpm oxfmt",
    "test": "vitest",
    "visualize": "npx tsx src/__examples__/storage.ts"
  },
  "devDependencies": {
    "@figliolia/event-emitter": "^1.2.0",
    "@figliolia/galena": "^4.0.5",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "chalk": "^4.1.2",
    "mitata": "^1.0.34",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.14.0",
    "oxlint-tsgolint": "^0.25.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@figliolia/event-emitter": ">=1.2.0",
    "@figliolia/galena": ">=4.0.0"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
