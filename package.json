{
  "name": "conduit",
  "version": "0.0.1",
  "private": true,
  "description": "A framework agnostic state composition library for server-derived data",
  "keywords": [],
  "homepage": "https://github.com/alexfigliolia/conduit#readme",
  "license": "MIT",
  "author": "Alex Figliolia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexfigliolia/conduit.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "install:repokit": "cargo install repokit",
    "install:rust": "command -v rustc >/dev/null 2>&1 || { curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y; source \"$HOME/.cargo/env\"; }",
    "install:vite": "command -v vp >/dev/null 2>&1 || { curl -fsSL https://vite.plus | bash; }",
    "lint": "pnpm oxlint --type-aware --report-unused-disable-directives --fix && pnpm oxfmt",
    "setup:repo": "pnpm i && pnpm install:rust && pnpm install:repokit && pnpm install:vite",
    "test": "vitest"
  },
  "devDependencies": {
    "@repokit/core": "^5.1.9",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "5.0.0",
    "dpdm": "^4.3.0",
    "madge": "^8.0.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^0.25.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
