{
  "name": "conduit",
  "version": "1.0.0",
  "private": true,
  "description": "A framework agnostic state composition library based on Galena",
  "keywords": [],
  "homepage": "https://github.com/alexfigliolia/conduit#readme",
  "license": "MIT",
  "author": "Alex Figliolia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexfigliolia/conduit.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "install:repokit": "cargo install repokit",
    "install:rust": "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh",
    "lint": "pnpm oxlint --type-aware --report-unused-disable-directives --fix && pnpm oxfmt",
    "setup:repo": "pnpm i && pnpm install:rust && pnpm install:repokit",
    "test": "vitest"
  },
  "devDependencies": {
    "@repokit/core": "^5.1.6",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.14.0",
    "oxlint-tsgolint": "^0.25.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
